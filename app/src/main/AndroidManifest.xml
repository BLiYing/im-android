<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      仅为 Android 9 及更早系统保存二维码到相册。Android 10（Q）起 MediaStore 分区存储
      不需要任何权限，故 maxSdkVersion=28 —— 不加这个上限，新系统上会白白多出一条
      「访问所有文件」级别的敏感权限声明，商店审核会问，用户也会被吓到。
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      读相册（自建选图宫格页）。**不得已才申请**：本来用的是 androidx PickVisualMedia
      （系统 Photo Picker，进程外、免权限），但那个在 Android 13 以下要靠系统更新下发的
      SDK extension，实测最低支持的 Android 11 上不存在，会回退成 DocumentsUI 文件浏览器。
      详见 data/MediaPick.kt 的注释。权限被拒时仍降级回系统选择器，功能不消失。

      三个名字对应三个版本段，缺一段就会在那一段系统上「相册永远是空的」：
        ≤32 READ_EXTERNAL_STORAGE / 33 READ_MEDIA_IMAGES / 34+ 再加 VISUAL_USER_SELECTED（部分授权）
      只申请图片：视频发送还没接（sendMedia 是整包字节上传，无分片），
      申请了 READ_MEDIA_VIDEO 却用不上就是纯粹的权限过度索取。
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <application
        android:name=".IMApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.IMAndroid">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.IMAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          分享二维码图片用。exported=false + grantUriPermissions：只有被我们显式授权的
          那一个 Intent 能读，别的应用主动来读会被拒。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
