<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 通知与提示音（NOTIFICATIONS_DESIGN §3.2）：来消息时一次性短振（40ms），普通权限、无弹窗。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      仅为 Android 9 及更早系统保存二维码到相册。Android 10（Q）起 MediaStore 分区存储
      不需要任何权限，故 maxSdkVersion=28 —— 不加这个上限，新系统上会白白多出一条
      「访问所有文件」级别的敏感权限声明，商店审核会问，用户也会被吓到。
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      读相册（自建选图宫格页）。**不得已才申请**：本来用的是 androidx PickVisualMedia
      （系统 Photo Picker，进程外、免权限），但那个在 Android 13 以下要靠系统更新下发的
      SDK extension，实测最低支持的 Android 11 上不存在，会回退成 DocumentsUI 文件浏览器。
      详见 data/MediaPick.kt 的注释。权限被拒时仍降级回系统选择器，功能不消失。

      三个名字对应三个版本段，缺一段就会在那一段系统上「相册永远是空的」：
        ≤32 READ_EXTERNAL_STORAGE / 33 READ_MEDIA_IMAGES / 34+ 再加 VISUAL_USER_SELECTED（部分授权）
      2026-09-07 加了 READ_MEDIA_VIDEO：视频发送已接（UploadApi.uploadStream 走服务端分片，
      峰值内存 = 一片 8MB，与文件大小无关），所以这条权限现在是真的用得上。
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!--
      扫一扫（QRCODE P0 接收方半，2026-09-22）。required=false：没有摄像头的设备
      （极少数平板/模拟器）仍可安装，扫码页自己按权限/硬件缺失分别给页面内提示，
      不像 iOS 那样另备「从相册识别」兜底（未接，见 docs/UI_PARITY_IOS.md）。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- 语音消息录制（VOICE_MESSAGE_DESIGN §5）。required=false 同理：没有麦克风的设备仍可安装。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      FCM 离线推送展示系统通知（M5 批次 2）。Android 13（API 33）起弹通知需要这条运行时权限，
      本轮**只声明权限、没接请求弹窗流程**（见 ui/NotificationSettingsHost.kt 调用点注释与任务收尾
      报告）——没有它时 NotificationManager.notify() 按官方文档是静默不弹，不会崩溃。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".IMApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.IMAndroid">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.IMAndroid" />

        <!--
          FCM 离线推送服务（M5 批次 2）。exported=false：只有系统 FCM 组件能唤起它，别的 App 不行。
          没有 google-services.json 时这条声明本身不会导致任何问题——只是永远不会真的被 FCM 唤起
          （没有注册到真实 Firebase 项目，系统压根不知道往哪投递）。
        -->
        <service
            android:name=".fcm.FcmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          桌面入口 = 四个 activity-alias，同一时刻只启用一个（外观页「应用图标」，对齐 iOS
          setAlternateIconName）。切换逻辑见 ui/AppIconSwitcher.kt；alias 名是持久化的一部分，
          **改名 = 用户选的图标丢失**。MainActivity 本身不再带 LAUNCHER，否则桌面会多出一个图标。
          **首发后 alias 名与 MainActivity 类名都不可再改**：用户钉在桌面的快捷方式记的是组件名，改了就失效
          （见 docs/UI_PARITY_IOS.md §4.11）。
        -->
        <activity-alias
            android:name=".LauncherDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherOcean"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ocean"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherViolet"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_violet"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherMidnight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_midnight"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          分享二维码图片用；2026-09-07 起**相机拍照**也走它（系统相机是另一个进程，
          Android 7+ 跨进程传 file:// 会抛 FileUriExposedException）。
          exported=false + grantUriPermissions：只有被我们显式授权的那一个 Intent 能读，
          别的应用主动来读会被拒。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
